" href="/favicon-32x32.png"><link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png"><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"><link rel="manifest" href="/site.webmanifest"><link rel="mask-icon" href="/safari-pinned-tab.svg" color="#6600FF"><meta name="apple-mobile-web-app-title" content="GetLikes"><meta name="application-name" content="GetLikes"><meta name="msapplication-TileColor" content="#ffffff"><meta name="msapplication-config" content="/browserconfig.xml"><meta name="theme-color" content="#6600FF"><link rel="preconnect" href="https://www.googletagmanager.com"><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://getlikes.com/#organization","name":"GetLikes","legalName":"GetLikes","url":"https://getlikes.com/","logo":{"@type":"ImageObject","url":"https://getlikes.com/assets/getlikes-logo.png"},"description":"GetLikes is a social media marketing and advertising service for Instagram, TikTok and YouTube. No password needed, orders start in minutes, and support answers seven days a week.","foundingDate":"2018","knowsAbout":["Social media marketing","Social media advertising","Instagram marketing","TikTok marketing","YouTube advertising","Audience growth","Influencer marketing"],"areaServed":{"@type":"GeoShape","name":"Worldwide"},"contactPoint":[{"@type":"ContactPoint","contactType":"customer support","url":"https://getlikes.com/contact/","availableLanguage":["English"],"hoursAvailable":{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],"opens":"00:00","closes":"23:59"}}]},{"@type":"WebSite","@id":"https://getlikes.com/#website","url":"https://getlikes.com/","name":"GetLikes","publisher":{"@id":"https://getlikes.com/#organization"},"inLanguage":"en-US"},{"@type":"WebPage","@id":"https://getlikes.com/#webpage","url":"https://getlikes.com/","name":"GetLikes","description":"Social media growth for Instagram, TikTok and YouTube.","isPartOf":{"@id":"https://getlikes.com/#website"},"about":{"@id":"https://getlikes.com/#organization"},"inLanguage":"en-US"},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How much does it cost to buy 1,000 followers?","acceptedAnswer":{"@type":"Answer","text":"1,000 Instagram followers cost $15.95 at GetLikes, and 1,000 TikTok followers are the same price. Likes and views cost less because they are cheaper to deliver."}},{"@type":"Question","name":"Does buying followers actually work?","acceptedAnswer":{"@type":"Answer","text":"It works for one specific thing: making your profile look established to someone deciding whether to follow you. It will not bring you customers, comments, or a place on the Explore page. Treat it as a nudge, not a growth plan."}},{"@type":"Question","name":"Is it legal to buy followers and likes?","acceptedAnswer":{"@type":"Answer","text":"Yes, it is legal. No law stops you paying for followers. It does break the terms of service of Instagram, TikTok and YouTube, so the risk sits with your account rather than with the courts. Platforms usually respond by removing the fake accounts, not by banning the buyer."}},{"@type":"Question","name":"Do you need my password?","acceptedAnswer":{"@type":"Answer","text":"No, and we never will. We only need your public username, or a link to the post you want boosted. Any service asking for your password can lock you out of your own account."}},{"@type":"Question","name":"How fast does delivery start?","acceptedAnswer":{"@type":"Answer","text":"Most orders start within a few minutes of payment. Small packages often finish the same day, and larger ones are spread out so the growth looks natural."}},{"@type":"Question","name":"What if something goes wrong?","acceptedAnswer":{"@type":"Answer","text":"Contact us within 7 days. If we missed the delivery window we stated, or the product was not what the page described, you can request a refund under our refund policy. If your counts drop below what you bought, we refill them for free."}}]}]}</script><script>(function(){const gtmId = "GTM-TK3WJB45";

